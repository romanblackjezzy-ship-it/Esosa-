{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and notification preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address (private)" },
        "photoUrl": { "type": "string", "description": "Optional avatar URL" },
        "username": { "type": "string", "description": "Optional handle/username" },
        "bio": { "type": "string", "description": "Optional profile bio" },
        "avatarKey": { "type": "string", "description": "Optional local avatar theme key" },
        "phoneNumber": { "type": "string", "description": "Optional phone number" },
        "authMethod": { "type": "string", "enum": ["google", "phone", "email"], "description": "Primary auth method" },
        "themeMode": { "type": "string", "enum": ["system", "light", "dark"], "description": "Preferred app theme" },
        "language": { "type": "string", "description": "Preferred UI language" },
        "notificationsEnabled": { "type": "boolean", "description": "Whether incoming message notifications are enabled" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "displayName", "email", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Real-time multi-user chat room.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Room display title" },
        "topic": { "type": "string", "description": "Room topic or subtitle" },
        "chatKind": { "type": "string", "enum": ["saved", "direct", "group", "channel"], "description": "Conversation kind" },
        "handle": { "type": "string", "description": "Optional contact email or room handle" },
        "isPublic": { "type": "boolean", "description": "Whether channel is public" },
        "disappearingSeconds": { "type": "integer", "description": "Auto-delete timer in seconds" },
        "pinnedMessageId": { "type": "string", "description": "Pinned message ID" },
        "pinnedMessageText": { "type": "string", "description": "Pinned message preview" },
        "memberNames": { "type": "array", "description": "Display names or emails of members" },
        "adminNames": { "type": "array", "description": "Display names of room admins" },
        "roomCode": { "type": "string", "description": "Shareable alphanumeric join code" },
        "ownerId": { "type": "string", "description": "Creator Firebase Auth UID" },
        "memberUids": { "type": "array", "description": "List of member UIDs" },
        "lastMessageText": { "type": "string", "description": "Preview of the latest message" },
        "lastMessageSenderName": { "type": "string", "description": "Name of latest sender" },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Server timestamp of latest message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "topic", "roomCode", "ownerId", "memberUids", "lastMessageText", "lastMessageSenderName", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "RoomInvite": {
      "title": "RoomInvite",
      "description": "Lookup index from join code to room ID.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Target room document ID" },
        "roomTitle": { "type": "string", "description": "Title of the target room" },
        "ownerId": { "type": "string", "description": "Creator UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["roomId", "roomTitle", "ownerId", "createdAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Real-time message in a chat room.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Parent room ID" },
        "senderId": { "type": "string", "description": "Sender Firebase Auth UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderPhotoUrl": { "type": "string", "description": "Optional sender photo URL" },
        "text": { "type": "string", "description": "Message text content or optional photo caption" },
        "imageUrl": { "type": "string", "description": "Optional HTTPS download URL for photo messages" },
        "storagePath": { "type": "string", "description": "Optional object path for photo cleanup" },
        "messageType": { "type": "string", "enum": ["text", "image", "voice", "document", "sticker", "gif"], "description": "Message content type" },
        "replyToMessageId": { "type": "string", "description": "Optional replied message ID" },
        "replyToSenderName": { "type": "string", "description": "Optional replied sender name" },
        "replyToPreviewText": { "type": "string", "description": "Optional replied text snippet" },
        "forwardedFromName": { "type": "string", "description": "Optional original sender if forwarded" },
        "voiceDurationSec": { "type": "integer", "description": "Optional voice note length in seconds" },
        "attachmentName": { "type": "string", "description": "Optional document/GIF label" },
        "attachmentSizeLabel": { "type": "string", "description": "Optional file size display" },
        "isEdited": { "type": "boolean", "description": "Whether the sender edited this message" },
        "memberUids": { "type": "array", "description": "Denormalized member UIDs from parent room" },
        "reactions": { "type": "object", "description": "Optional map of emoji to list of reacting UIDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["roomId", "senderId", "senderName", "text", "memberUids", "createdAt"]
    },
    "RoomTypingStatus": {
      "title": "RoomTypingStatus",
      "description": "Ephemeral typing indicator for a member in a chat room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Typing user Firebase Auth UID" },
        "roomId": { "type": "string", "description": "Parent room ID" },
        "displayName": { "type": "string", "description": "Display name of the typing member" },
        "typing": { "type": "boolean", "description": "Whether the user is currently typing" },
        "memberUids": { "type": "array", "description": "Denormalized member UIDs from parent room" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "roomId", "displayName", "typing", "memberUids", "updatedAt"]
    },
    "AiThread": {
      "title": "AiThread",
      "description": "Multi-turn Gemini AI conversation thread with persona and model.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "title": { "type": "string", "description": "Thread title" },
        "personaId": { "type": "string", "enum": ["general", "reasoning", "interactive", "fast"], "description": "Chatbot role ID" },
        "modelName": { "type": "string", "enum": ["gemini-4-hydrogen", "gemini-4-carbon", "gemini-4-neon", "gemini-3.1-flash-lite"], "description": "Gemini model ID" },
        "systemInstruction": { "type": "string", "description": "System instruction for the persona" },
        "lastMessagePreview": { "type": "string", "description": "Latest message preview" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "title", "personaId", "modelName", "systemInstruction", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "AiMessage": {
      "title": "AiMessage",
      "description": "Single turn in a Gemini AI conversation thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "threadId": { "type": "string", "description": "Parent AI thread ID" },
        "role": { "type": "string", "enum": ["user", "model"], "description": "Message speaker role" },
        "text": { "type": "string", "description": "Message content" },
        "modelName": { "type": "string", "description": "Model used for this turn" },
        "reactions": { "type": "object", "description": "Optional map of emoji to list of reacting UIDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "threadId", "role", "text", "modelName", "createdAt"]
    },
    "AppRelease": {
      "title": "AppRelease",
      "description": "Read-only app release metadata used to notify users of new APK updates on app open.",
      "type": "object",
      "properties": {
        "latestVersionCode": { "type": "integer", "description": "Latest Android versionCode" },
        "latestVersionName": { "type": "string", "description": "Latest semantic versionName" },
        "releaseNotes": { "type": "string", "description": "Summary of changes in this release" },
        "downloadUrl": { "type": "string", "description": "HTTPS URL to download the updated APK or release page" },
        "isMandatory": { "type": "boolean", "description": "Whether the update should be marked as recommended/mandatory" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["latestVersionCode", "latestVersionName", "releaseNotes", "downloadUrl"]
    },
    "LiveVoiceThread": {
      "title": "LiveVoiceThread",
      "description": "Persistent Gemini Live Voice conversation thread owned by a signed-in user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "title": { "type": "string", "description": "Voice session thread title" },
        "modelName": { "type": "string", "description": "Gemini Live model ID" },
        "lastTranscriptPreview": { "type": "string", "description": "Preview of the latest spoken or text turn" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "title", "modelName", "lastTranscriptPreview", "createdAt", "updatedAt"]
    },
    "LiveVoiceMessage": {
      "title": "LiveVoiceMessage",
      "description": "Single persisted transcript turn inside a Gemini Live Voice thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "threadId": { "type": "string", "description": "Parent Live Voice thread ID" },
        "speaker": { "type": "string", "enum": ["You", "Esosa Live"], "description": "Speaker label" },
        "text": { "type": "string", "description": "Transcript content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "threadId", "speaker", "text", "createdAt"]
    },
    "SocialPost": {
      "title": "SocialPost",
      "description": "Public photo post or vertical Reel published by an authenticated user.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "Author Firebase Auth UID" },
        "authorUsername": { "type": "string", "description": "Author handle" },
        "authorDisplayName": { "type": "string", "description": "Author display name" },
        "authorPhotoUrl": { "type": "string", "description": "Optional author avatar URL" },
        "mediaType": { "type": "string", "enum": ["photo", "reel"], "description": "Post or Reel format" },
        "imageUrl": { "type": "string", "description": "HTTPS download URL for the post or reel visual" },
        "storagePath": { "type": "string", "description": "Firebase Storage path for owner cleanup" },
        "caption": { "type": "string", "description": "Post caption and hashtags" },
        "location": { "type": "string", "description": "Optional location tag" },
        "audioLabel": { "type": "string", "description": "Optional Reel audio track label" },
        "aspectRatio": { "type": "number", "description": "Display aspect ratio hint" },
        "likedByUids": { "type": "array", "description": "List of UIDs who liked the post" },
        "commentCount": { "type": "integer", "description": "Total comment count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["authorId", "authorUsername", "authorDisplayName", "mediaType", "imageUrl", "caption", "likedByUids", "commentCount", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a social post or Reel.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "Parent post ID" },
        "authorId": { "type": "string", "description": "Comment author UID" },
        "authorUsername": { "type": "string", "description": "Comment author handle" },
        "authorPhotoUrl": { "type": "string", "description": "Optional comment author avatar URL" },
        "text": { "type": "string", "description": "Comment text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["postId", "authorId", "authorUsername", "text", "createdAt"]
    },
    "SocialStory": {
      "title": "SocialStory",
      "description": "Ephemeral-style social story published by a user.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "Author UID" },
        "authorUsername": { "type": "string", "description": "Author handle" },
        "authorPhotoUrl": { "type": "string", "description": "Optional author avatar URL" },
        "imageUrl": { "type": "string", "description": "Optional HTTPS image URL for photo stories" },
        "storagePath": { "type": "string", "description": "Optional Firebase Storage path" },
        "caption": { "type": "string", "description": "Story caption or status text" },
        "viewedByUids": { "type": "array", "description": "UIDs that have viewed the story" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["authorId", "authorUsername", "caption", "viewedByUids", "createdAt"]
    },
    "SavedPostRef": {
      "title": "SavedPostRef",
      "description": "Private bookmarked post reference for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "postId": { "type": "string", "description": "Bookmarked post ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "UserFollowRef": {
      "title": "UserFollowRef",
      "description": "Public follow edge from followerId to targetUid.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "description": "Follower UID" },
        "targetUid": { "type": "string", "description": "Followed creator UID" },
        "targetUsername": { "type": "string", "description": "Followed creator username" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["followerId", "targetUid", "targetUsername", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and notification preferences."
    },
    "/users/{userId}/saved_posts/{postId}": {
      "schema": { "$ref": "#/entities/SavedPostRef" },
      "description": "Private saved/bookmarked posts for a user."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/SocialPost" },
      "description": "Community Instagram-style photo posts and vertical Reels."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments on a social post or Reel."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/SocialStory" },
      "description": "Community stories shown in the top Home strip."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/UserFollowRef" },
      "description": "Follow relationships between users."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Real-time chat rooms accessible to members."
    },
    "/invites/{roomCode}": {
      "schema": { "$ref": "#/entities/RoomInvite" },
      "description": "Direct invite code lookups for joining rooms."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Real-time chat messages inside a room."
    },
    "/rooms/{roomId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/RoomTypingStatus" },
      "description": "Real-time typing indicator status per member in a room."
    },
    "/users/{userId}/ai_threads/{threadId}": {
      "schema": { "$ref": "#/entities/AiThread" },
      "description": "User's multi-turn Gemini AI chat threads."
    },
    "/users/{userId}/ai_threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/AiMessage" },
      "description": "Multi-turn messages within an AI thread."
    },
    "/users/{userId}/live_threads/{threadId}": {
      "schema": { "$ref": "#/entities/LiveVoiceThread" },
      "description": "User's persistent Gemini Live Voice conversation threads."
    },
    "/users/{userId}/live_threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/LiveVoiceMessage" },
      "description": "Persisted transcript messages within a Live Voice thread."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppRelease" },
      "description": "Read-only app update release configuration."
    }
  }
}
