{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and notification preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address (private)" },
        "photoUrl": { "type": "string", "description": "Optional avatar URL" },
        "notificationsEnabled": { "type": "boolean", "description": "Whether incoming message notifications are enabled" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "displayName", "email", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Real-time multi-user chat room.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Room display title" },
        "topic": { "type": "string", "description": "Room topic or subtitle" },
        "roomCode": { "type": "string", "description": "Shareable alphanumeric join code" },
        "ownerId": { "type": "string", "description": "Creator Firebase Auth UID" },
        "memberUids": { "type": "array", "description": "List of member UIDs" },
        "lastMessageText": { "type": "string", "description": "Preview of the latest message" },
        "lastMessageSenderName": { "type": "string", "description": "Name of latest sender" },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Server timestamp of latest message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "topic", "roomCode", "ownerId", "memberUids", "lastMessageText", "lastMessageSenderName", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "RoomInvite": {
      "title": "RoomInvite",
      "description": "Lookup index from join code to room ID.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Target room document ID" },
        "roomTitle": { "type": "string", "description": "Title of the target room" },
        "ownerId": { "type": "string", "description": "Creator UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["roomId", "roomTitle", "ownerId", "createdAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Real-time message in a chat room.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Parent room ID" },
        "senderId": { "type": "string", "description": "Sender Firebase Auth UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderPhotoUrl": { "type": "string", "description": "Optional sender photo URL" },
        "text": { "type": "string", "description": "Message text content" },
        "memberUids": { "type": "array", "description": "Denormalized member UIDs from parent room" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["roomId", "senderId", "senderName", "text", "memberUids", "createdAt"]
    },
    "AiThread": {
      "title": "AiThread",
      "description": "Multi-turn Gemini AI conversation thread with persona and model.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "title": { "type": "string", "description": "Thread title" },
        "personaId": { "type": "string", "enum": ["general", "reasoning", "interactive", "fast"], "description": "Chatbot role ID" },
        "modelName": { "type": "string", "enum": ["gemini-4-hydrogen", "gemini-4-carbon", "gemini-4-neon", "gemini-3.1-flash-lite"], "description": "Gemini model ID" },
        "systemInstruction": { "type": "string", "description": "System instruction for the persona" },
        "lastMessagePreview": { "type": "string", "description": "Latest message preview" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "title", "personaId", "modelName", "systemInstruction", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "AiMessage": {
      "title": "AiMessage",
      "description": "Single turn in a Gemini AI conversation thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "threadId": { "type": "string", "description": "Parent AI thread ID" },
        "role": { "type": "string", "enum": ["user", "model"], "description": "Message speaker role" },
        "text": { "type": "string", "description": "Message content" },
        "modelName": { "type": "string", "description": "Model used for this turn" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "threadId", "role", "text", "modelName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and notification preferences."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Real-time chat rooms accessible to members."
    },
    "/invites/{roomCode}": {
      "schema": { "$ref": "#/entities/RoomInvite" },
      "description": "Direct invite code lookups for joining rooms."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Real-time chat messages inside a room."
    },
    "/users/{userId}/ai_threads/{threadId}": {
      "schema": { "$ref": "#/entities/AiThread" },
      "description": "User's multi-turn Gemini AI chat threads."
    },
    "/users/{userId}/ai_threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/AiMessage" },
      "description": "Multi-turn messages within an AI thread."
    }
  }
}
