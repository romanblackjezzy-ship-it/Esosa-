rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 40)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('avatarKey' in data) || (data.avatarKey is string && data.avatarKey.size() <= 64)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             (!('authMethod' in data) || data.authMethod in ['google', 'phone', 'email']) &&
             (!('themeMode' in data) || data.themeMode in ['system', 'light', 'dark']) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 40)) &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 10)) &&
             (!('role' in data) || data.role in ['member', 'moderator']) &&
             data.notificationsEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isModerator() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'moderator'
        )
      );
    }

    function isValidStorageUsage(data) {
      return data.usedBytes is int && data.usedBytes >= 0 && data.usedBytes <= 1099511627776 &&
             data.quotaBytes is int && data.quotaBytes >= 1048576 && data.quotaBytes <= 1099511627776 &&
             data.warningThresholdPercent is int && data.warningThresholdPercent >= 50 && data.warningThresholdPercent <= 95 &&
             data.fileCount is int && data.fileCount >= 0 && data.fileCount <= 10000000 &&
             data.photoBytes is int && data.photoBytes >= 0 && data.photoBytes <= 1099511627776 &&
             data.videoBytes is int && data.videoBytes >= 0 && data.videoBytes <= 1099511627776 &&
             data.audioBytes is int && data.audioBytes >= 0 && data.audioBytes <= 1099511627776 &&
             data.activeBackendLabel is string && data.activeBackendLabel.size() >= 1 && data.activeBackendLabel.size() <= 80 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.topic is string && data.topic.size() <= 160 &&
             (!('chatKind' in data) || data.chatKind in ['saved', 'direct', 'group', 'channel']) &&
             (!('handle' in data) || (data.handle is string && data.handle.size() <= 120)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('disappearingSeconds' in data) || (data.disappearingSeconds is int && data.disappearingSeconds >= 0 && data.disappearingSeconds <= 604800)) &&
             (!('pinnedMessageId' in data) || (data.pinnedMessageId is string && data.pinnedMessageId.size() <= 128)) &&
             (!('pinnedMessageText' in data) || (data.pinnedMessageText is string && data.pinnedMessageText.size() <= 160)) &&
             (!('memberNames' in data) || (data.memberNames is list && data.memberNames.size() <= 25)) &&
             (!('adminNames' in data) || (data.adminNames is list && data.adminNames.size() <= 25)) &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 &&
             data.roomCode.matches('^[A-Za-z0-9_\\-]+$') &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.lastMessageText is string && data.lastMessageText.size() <= 500 &&
             data.lastMessageSenderName is string && data.lastMessageSenderName.size() <= 80 &&
             data.lastMessageAt is timestamp && data.lastMessageAt <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidInvite(data) {
      return isValidId(data.roomId) &&
             data.roomTitle is string && data.roomTitle.size() >= 1 && data.roomTitle.size() <= 80 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRoomMessage(data) {
      return isValidId(data.roomId) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             (!('senderPhotoUrl' in data) || (data.senderPhotoUrl is string && data.senderPhotoUrl.size() <= 500)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() >= 8 && data.imageUrl.size() <= 2000 && data.imageUrl.matches('^(https://|esosa-media://).*'))) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500)) &&
             (!('messageType' in data) || data.messageType in ['text', 'image', 'voice', 'document', 'sticker', 'gif']) &&
             (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('replyToSenderName' in data) || (data.replyToSenderName is string && data.replyToSenderName.size() <= 80)) &&
             (!('replyToPreviewText' in data) || (data.replyToPreviewText is string && data.replyToPreviewText.size() <= 160)) &&
             (!('forwardedFromName' in data) || (data.forwardedFromName is string && data.forwardedFromName.size() <= 80)) &&
             (!('voiceDurationSec' in data) || (data.voiceDurationSec is int && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 600)) &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 120)) &&
             (!('attachmentSizeLabel' in data) || (data.attachmentSizeLabel is string && data.attachmentSizeLabel.size() <= 40)) &&
             (!('isEdited' in data) || data.isEdited is bool) &&
             data.text is string && data.text.size() <= 4000 &&
             (data.text.size() >= 1 || ('imageUrl' in data)) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 10)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRoomTypingStatus(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.roomId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.typing is bool &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAiThread(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.personaId in ['general', 'reasoning', 'interactive', 'fast'] &&
             data.modelName in ['gemini-4-hydrogen', 'gemini-4-carbon', 'gemini-4-neon', 'gemini-3.1-flash-lite'] &&
             data.systemInstruction is string && data.systemInstruction.size() >= 1 && data.systemInstruction.size() <= 1000 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAiMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.threadId) &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 20000 &&
             data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80 &&
             (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 10)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLiveThread(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80 &&
             data.lastTranscriptPreview is string && data.lastTranscriptPreview.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.threadId) &&
             data.speaker in ['You', 'Esosa Live'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSocialPost(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             data.authorDisplayName is string && data.authorDisplayName.size() >= 1 && data.authorDisplayName.size() <= 80 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 2000)) &&
             data.mediaType in ['photo', 'reel'] &&
             data.imageUrl is string && data.imageUrl.size() >= 8 && data.imageUrl.size() <= 2000 && data.imageUrl.matches('^(https://|esosa-media://).*') &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() >= 8 && data.videoUrl.size() <= 2000 && data.videoUrl.matches('^(https://|esosa-media://).*'))) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500)) &&
             data.caption is string && data.caption.size() <= 2200 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('audioLabel' in data) || (data.audioLabel is string && data.audioLabel.size() <= 120)) &&
             (!('taggedUsernames' in data) || (data.taggedUsernames is list && data.taggedUsernames.size() <= 20)) &&
             (!('aspectRatio' in data) || ((data.aspectRatio is float || data.aspectRatio is int) && data.aspectRatio >= 0.4 && data.aspectRatio <= 2.5)) &&
             data.likedByUids is list && data.likedByUids.size() <= 1000 &&
             data.commentCount is int && data.commentCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPostComment(data) {
      return isValidId(data.postId) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 2000)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSocialStory(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 2000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() >= 8 && data.imageUrl.size() <= 2000 && data.imageUrl.matches('^(https://|esosa-media://).*'))) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() >= 8 && data.videoUrl.size() <= 2000 && data.videoUrl.matches('^(https://|esosa-media://).*'))) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500)) &&
             data.caption is string && data.caption.size() <= 300 &&
             (('imageUrl' in data) || ('videoUrl' in data) || data.caption.size() >= 1) &&
             data.viewedByUids is list && data.viewedByUids.size() <= 1000 &&
             (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 16)) &&
             (!('archived' in data) || data.archived is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStoryReply(data) {
      return isValidId(data.storyId) &&
             data.storyAuthorId is string && data.storyAuthorId.size() >= 1 && data.storyAuthorId.size() <= 128 &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 2000)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSavedPostRef(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.postId) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserFollowRef(data) {
      return data.followerId is string && data.followerId.size() >= 1 && data.followerId.size() <= 128 &&
             data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             data.followerId != data.targetUid &&
             data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStoryHighlight(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2000)) &&
             data.storyIds is list && data.storyIds.size() >= 1 && data.storyIds.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMediaBlob(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.contentType is string && data.contentType.size() >= 3 && data.contentType.size() <= 80 &&
             data.fileExtension is string && data.fileExtension.size() >= 1 && data.fileExtension.size() <= 12 &&
             data.totalBytes is int && data.totalBytes >= 1 && data.totalBytes <= 10485760 &&
             data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 25 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMediaBlobChunk(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.index is int && data.index >= 0 && data.index < 25 &&
             data.data is string && data.data.size() >= 1 && data.data.size() <= 700000;
    }

    // 1. Private User Profile & Settings
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'username', 'bio', 'avatarKey', 'phoneNumber', 'authMethod', 'themeMode', 'language', 'fcmToken', 'fcmTokens', 'role', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       (!('role' in incoming()) || incoming().role == 'member') &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('role' in incoming()) || incoming().role == existing().get('role', 'member')) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'username', 'bio', 'avatarKey', 'phoneNumber', 'authMethod', 'themeMode', 'language', 'fcmToken', 'fcmTokens', 'notificationsEnabled', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // 5. User-scoped Gemini AI Threads
      match /ai_threads/{threadId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(threadId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(threadId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'personaId', 'modelName', 'systemInstruction', 'lastMessagePreview', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'personaId', 'modelName', 'systemInstruction', 'lastMessagePreview', 'createdAt', 'updatedAt']) &&
                         isValidAiThread(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(threadId) &&
                         request.auth.uid == userId &&
                         isValidAiThread(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'personaId', 'modelName', 'systemInstruction', 'lastMessagePreview', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(threadId) && request.auth.uid == userId;

        // 6. User-scoped Gemini AI Thread Messages
        match /messages/{messageId} {
          allow get: if isSignedIn() && isValidId(userId) && isValidId(threadId) && isValidId(messageId) && request.auth.uid == userId;
          allow list: if isSignedIn() && request.auth.uid == userId;

          allow create: if isSignedIn() &&
                           isValidId(userId) &&
                           isValidId(threadId) &&
                           isValidId(messageId) &&
                           request.auth.uid == userId &&
                           incoming().userId == request.auth.uid &&
                           incoming().threadId == threadId &&
                           incoming().keys().hasAll(['userId', 'threadId', 'role', 'text', 'modelName', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'threadId', 'role', 'text', 'modelName', 'reactions', 'createdAt']) &&
                           isValidAiMessage(incoming());

          allow update: if isSignedIn() &&
                           isValidId(userId) &&
                           isValidId(threadId) &&
                           isValidId(messageId) &&
                           request.auth.uid == userId &&
                           isValidAiMessage(incoming()) &&
                           incoming().userId == existing().userId &&
                           incoming().threadId == existing().threadId &&
                           incoming().role == existing().role &&
                           incoming().text == existing().text &&
                           incoming().modelName == existing().modelName &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['reactions']);
          allow delete: if isSignedIn() && isValidId(userId) && isValidId(threadId) && isValidId(messageId) && request.auth.uid == userId;
        }
      }

      // 7. User-scoped Gemini Live Voice Threads
      match /live_threads/{threadId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(threadId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(threadId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'modelName', 'lastTranscriptPreview', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'modelName', 'lastTranscriptPreview', 'createdAt', 'updatedAt']) &&
                         isValidLiveThread(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(threadId) &&
                         request.auth.uid == userId &&
                         isValidLiveThread(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'modelName', 'lastTranscriptPreview', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(threadId) && request.auth.uid == userId;

        // 8. User-scoped Gemini Live Voice Transcript Messages
        match /messages/{messageId} {
          allow get: if isSignedIn() && isValidId(userId) && isValidId(threadId) && isValidId(messageId) && request.auth.uid == userId;
          allow list: if isSignedIn() && request.auth.uid == userId;

          allow create: if isSignedIn() &&
                           isValidId(userId) &&
                           isValidId(threadId) &&
                           isValidId(messageId) &&
                           request.auth.uid == userId &&
                           incoming().userId == request.auth.uid &&
                           incoming().threadId == threadId &&
                           incoming().keys().hasAll(['userId', 'threadId', 'speaker', 'text', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'threadId', 'speaker', 'text', 'createdAt']) &&
                           isValidLiveMessage(incoming());

          allow update: if false;
          allow delete: if isSignedIn() && isValidId(userId) && isValidId(threadId) && isValidId(messageId) && request.auth.uid == userId;
        }
      }

      // 9. Private Saved/Bookmarked Posts
      match /saved_posts/{postId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(postId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['userId', 'postId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'postId', 'createdAt']) &&
                         isValidSavedPostRef(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(postId) && request.auth.uid == userId;
      }
    }

    // 2. Real-Time Chat Rooms
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (request.auth.uid in existing().memberUids || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().memberUids.size() == 1 &&
                       incoming().keys().hasAll(['title', 'topic', 'roomCode', 'ownerId', 'memberUids', 'lastMessageText', 'lastMessageSenderName', 'lastMessageAt', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'topic', 'chatKind', 'handle', 'isPublic', 'disappearingSeconds', 'pinnedMessageId', 'pinnedMessageText', 'memberNames', 'adminNames', 'roomCode', 'ownerId', 'memberUids', 'lastMessageText', 'lastMessageSenderName', 'lastMessageAt', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().roomCode == existing().roomCode && (
                         // Action: Member sends message or edits room metadata
                         (
                           (request.auth.uid in existing().memberUids) &&
                           incoming().memberUids == existing().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'topic', 'chatKind', 'handle', 'isPublic', 'disappearingSeconds', 'pinnedMessageId', 'pinnedMessageText', 'memberNames', 'adminNames', 'lastMessageText', 'lastMessageSenderName', 'lastMessageAt', 'updatedAt'])
                         ) ||
                         // Action: New user joins room using invite code
                         (
                           !(request.auth.uid in existing().memberUids) &&
                           exists(/databases/$(database)/documents/invites/$(existing().roomCode)) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                           (request.auth.uid in incoming().memberUids)
                         ) ||
                         // Action: Non-owner member leaves room
                         (
                           (request.auth.uid in existing().memberUids) &&
                           request.auth.uid != existing().ownerId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                           existing().memberUids.hasAll(incoming().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                           !(request.auth.uid in incoming().memberUids)
                         )
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().ownerId == request.auth.uid;

      // 4. Real-Time Room Messages (denormalized memberUids for fast flat evaluation)
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && (request.auth.uid in existing().memberUids);
        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidRoomMessage(incoming()) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().keys().hasAll(['roomId', 'senderId', 'senderName', 'text', 'memberUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['roomId', 'senderId', 'senderName', 'senderPhotoUrl', 'text', 'imageUrl', 'storagePath', 'messageType', 'replyToMessageId', 'replyToSenderName', 'replyToPreviewText', 'forwardedFromName', 'voiceDurationSec', 'attachmentName', 'attachmentSizeLabel', 'isEdited', 'memberUids', 'reactions', 'createdAt']) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         incoming().memberUids == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidRoomMessage(incoming()) &&
                         (request.auth.uid in existing().memberUids) &&
                         incoming().roomId == existing().roomId &&
                         incoming().senderId == existing().senderId &&
                         incoming().senderName == existing().senderName &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().createdAt == existing().createdAt &&
                         (!('senderPhotoUrl' in existing()) ? !('senderPhotoUrl' in incoming()) : incoming().senderPhotoUrl == existing().senderPhotoUrl) &&
                         (!('imageUrl' in existing()) ? !('imageUrl' in incoming()) : incoming().imageUrl == existing().imageUrl) &&
                         (!('storagePath' in existing()) ? !('storagePath' in incoming()) : incoming().storagePath == existing().storagePath) &&
                         (!('messageType' in existing()) ? !('messageType' in incoming()) : incoming().messageType == existing().messageType) &&
                         (
                           (
                             incoming().text == existing().text &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
                           ) || (
                             existing().senderId == request.auth.uid &&
                             incoming().text.size() >= 1 &&
                             incoming().isEdited == true &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited'])
                           ) || (
                             incoming().text == existing().text &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status'])
                           ) || (
                             incoming().text == existing().text &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'status'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && existing().senderId == request.auth.uid;
      }

      // 5. Real-Time Room Typing Status (per-user document, denormalized memberUids)
      match /typing/{userId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(userId) && (request.auth.uid in existing().memberUids);
        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         isValidRoomTypingStatus(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().roomId == roomId &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().keys().hasAll(['userId', 'roomId', 'displayName', 'typing', 'memberUids', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'roomId', 'displayName', 'typing', 'memberUids', 'updatedAt']) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         incoming().memberUids == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         isValidRoomTypingStatus(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'typing', 'memberUids', 'updatedAt']) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         incoming().memberUids == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(userId) && request.auth.uid == userId;
      }
    }

    // 3. Direct Room Invite Codes (get-only, never listable)
    match /invites/{roomCode} {
      allow get: if isSignedIn() && isValidId(roomCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(roomCode) &&
                       isValidInvite(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['roomId', 'roomTitle', 'ownerId', 'createdAt']) &&
                       incoming().keys().hasOnly(['roomId', 'roomTitle', 'ownerId', 'createdAt']) &&
                       exists(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
                       get(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.ownerId == request.auth.uid;

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(roomCode) && existing().ownerId == request.auth.uid;
    }

    // 4. Read-Only App Release Configuration (get-only for signed-in users, admin-managed)
    match /app_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 5. Community Social Posts & Reels
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likedByUids.size() == 0 &&
                       incoming().commentCount == 0 &&
                       incoming().keys().hasAll(['authorId', 'authorUsername', 'authorDisplayName', 'mediaType', 'imageUrl', 'caption', 'likedByUids', 'commentCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorUsername', 'authorDisplayName', 'authorPhotoUrl', 'mediaType', 'imageUrl', 'videoUrl', 'storagePath', 'caption', 'location', 'audioLabel', 'taggedUsernames', 'aspectRatio', 'likedByUids', 'commentCount', 'createdAt']) &&
                       isValidSocialPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidSocialPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().authorUsername == existing().authorUsername &&
                       incoming().authorDisplayName == existing().authorDisplayName &&
                       incoming().mediaType == existing().mediaType &&
                       incoming().imageUrl == existing().imageUrl &&
                       incoming().createdAt == existing().createdAt &&
                       (!('videoUrl' in existing()) ? !('videoUrl' in incoming()) : incoming().videoUrl == existing().videoUrl) &&
                       (!('storagePath' in existing()) ? !('storagePath' in incoming()) : incoming().storagePath == existing().storagePath) &&
                       (!('authorPhotoUrl' in existing()) ? !('authorPhotoUrl' in incoming()) : incoming().authorPhotoUrl == existing().authorPhotoUrl) &&
                       (
                         // Toggle own UID in likedByUids
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['likedByUids']) &&
                           (
                             (
                               !(request.auth.uid in existing().likedByUids) &&
                               (request.auth.uid in incoming().likedByUids) &&
                               incoming().likedByUids.hasAll(existing().likedByUids) &&
                               incoming().likedByUids.size() == existing().likedByUids.size() + 1
                             ) || (
                               (request.auth.uid in existing().likedByUids) &&
                               !(request.auth.uid in incoming().likedByUids) &&
                               existing().likedByUids.hasAll(incoming().likedByUids) &&
                               incoming().likedByUids.size() == existing().likedByUids.size() - 1
                             )
                           )
                         ) ||
                         // Increment commentCount by 1 when posting a comment
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['commentCount']) &&
                           incoming().commentCount == existing().commentCount + 1
                         ) ||
                         // Author edits caption/location/audioLabel/taggedUsernames
                         (
                           existing().authorId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'location', 'audioLabel', 'taggedUsernames'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         incoming().postId == postId &&
                         incoming().authorId == request.auth.uid &&
                         incoming().keys().hasAll(['postId', 'authorId', 'authorUsername', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'authorId', 'authorUsername', 'authorPhotoUrl', 'text', 'createdAt']) &&
                         isValidPostComment(incoming());

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (
                           existing().authorId == request.auth.uid ||
                           get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
                         );
      }
    }

    // 6. Community Stories
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().viewedByUids.size() == 0 &&
                       (!('reactions' in incoming()) || incoming().reactions.size() == 0) &&
                       (!('archived' in incoming()) || incoming().archived == false) &&
                       incoming().keys().hasAll(['authorId', 'authorUsername', 'caption', 'viewedByUids', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorUsername', 'authorPhotoUrl', 'imageUrl', 'videoUrl', 'storagePath', 'caption', 'viewedByUids', 'reactions', 'archived', 'createdAt']) &&
                       isValidSocialStory(incoming());

      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidSocialStory(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().authorUsername == existing().authorUsername &&
                       incoming().caption == existing().caption &&
                       incoming().createdAt == existing().createdAt &&
                       (!('imageUrl' in existing()) ? !('imageUrl' in incoming()) : incoming().imageUrl == existing().imageUrl) &&
                       (!('videoUrl' in existing()) ? !('videoUrl' in incoming()) : incoming().videoUrl == existing().videoUrl) &&
                       (!('storagePath' in existing()) ? !('storagePath' in incoming()) : incoming().storagePath == existing().storagePath) &&
                       (
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewedByUids']) &&
                           !(request.auth.uid in existing().viewedByUids) &&
                           (request.auth.uid in incoming().viewedByUids) &&
                           incoming().viewedByUids.hasAll(existing().viewedByUids) &&
                           incoming().viewedByUids.size() == existing().viewedByUids.size() + 1
                         ) ||
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) &&
                           incoming().reactions is map &&
                           incoming().reactions.size() <= 16
                         ) ||
                         (
                           existing().authorId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['archived']) &&
                           incoming().archived is bool
                         )
                       );

      allow delete: if isSignedIn() && isValidId(storyId) && existing().authorId == request.auth.uid;

      match /replies/{replyId} {
        allow get: if isSignedIn() &&
                      isValidId(storyId) &&
                      isValidId(replyId) &&
                      (existing().authorId == request.auth.uid || existing().storyAuthorId == request.auth.uid);

        allow list: if isSignedIn() &&
                       isValidId(storyId) &&
                       (existing().authorId == request.auth.uid || existing().storyAuthorId == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(replyId) &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         incoming().storyId == storyId &&
                         incoming().authorId == request.auth.uid &&
                         incoming().storyAuthorId == get(/databases/$(database)/documents/stories/$(storyId)).data.authorId &&
                         incoming().keys().hasAll(['storyId', 'storyAuthorId', 'authorId', 'authorUsername', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['storyId', 'storyAuthorId', 'authorId', 'authorUsername', 'authorPhotoUrl', 'text', 'createdAt']) &&
                         isValidStoryReply(incoming());

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(replyId) &&
                         (existing().authorId == request.auth.uid || existing().storyAuthorId == request.auth.uid);
      }
    }

    // 7. Follow Graph
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       incoming().followerId == request.auth.uid &&
                       followId == (request.auth.uid + '_' + incoming().targetUid) &&
                       incoming().keys().hasAll(['followerId', 'targetUid', 'targetUsername', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerId', 'targetUid', 'targetUsername', 'createdAt']) &&
                       isValidUserFollowRef(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
    }

    // 8. Story Highlights
    match /highlights/{highlightId} {
      allow get: if isSignedIn() && isValidId(highlightId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(highlightId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().keys().hasAll(['authorId', 'title', 'storyIds', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorId', 'title', 'coverUrl', 'storyIds', 'createdAt']) &&
                       isValidStoryHighlight(incoming());

      allow update: if isSignedIn() &&
                       isValidId(highlightId) &&
                       existing().authorId == request.auth.uid &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'coverUrl', 'storyIds']) &&
                       isValidStoryHighlight(incoming());

      allow delete: if isSignedIn() && isValidId(highlightId) && existing().authorId == request.auth.uid;
    }

    // 9. Cloud Media Blobs (Firestore-backed storage for photos, videos, avatars, and voice notes)
    match /media_blobs/{mediaId} {
      allow get: if isSignedIn() && isValidId(mediaId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(mediaId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'contentType', 'fileExtension', 'totalBytes', 'totalChunks', 'createdAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'contentType', 'fileExtension', 'totalBytes', 'totalChunks', 'createdAt']) &&
                       isValidMediaBlob(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(mediaId) && existing().ownerId == request.auth.uid;

      match /chunks/{chunkIndex} {
        allow get: if isSignedIn() && isValidId(mediaId) && chunkIndex.matches('^[0-9]{1,2}$');
        allow list: if isSignedIn() && isValidId(mediaId);

        allow create: if isSignedIn() &&
                         isValidId(mediaId) &&
                         chunkIndex.matches('^[0-9]{1,2}$') &&
                         incoming().ownerId == request.auth.uid &&
                         incoming().keys().hasAll(['ownerId', 'index', 'data']) &&
                         incoming().keys().hasOnly(['ownerId', 'index', 'data']) &&
                         isValidMediaBlobChunk(incoming()) &&
                         get(/databases/$(database)/documents/media_blobs/$(mediaId)).data.ownerId == request.auth.uid;

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(mediaId) &&
                         chunkIndex.matches('^[0-9]{1,2}$') &&
                         (
                           existing().ownerId == request.auth.uid ||
                           get(/databases/$(database)/documents/media_blobs/$(mediaId)).data.ownerId == request.auth.uid
                         );
      }
    }

    // 10. Server-Managed Moderator Directory (read-only self check; client writes forbidden)
    match /moderators/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // 11. Firebase Storage & Cloud Media Usage Metrics (only moderators can alter threshold/quota)
    match /storage_usage/{usageDocId} {
      allow get: if isSignedIn() && usageDocId == 'global';
      allow list: if false;

      allow create: if isSignedIn() &&
                       usageDocId == 'global' &&
                       incoming().keys().hasAll(['usedBytes', 'quotaBytes', 'warningThresholdPercent', 'fileCount', 'photoBytes', 'videoBytes', 'audioBytes', 'activeBackendLabel', 'updatedAt']) &&
                       incoming().keys().hasOnly(['usedBytes', 'quotaBytes', 'warningThresholdPercent', 'fileCount', 'photoBytes', 'videoBytes', 'audioBytes', 'activeBackendLabel', 'updatedAt']) &&
                       isValidStorageUsage(incoming()) &&
                       (
                         isModerator() ||
                         (incoming().warningThresholdPercent == 80 && incoming().quotaBytes == 1073741824)
                       );

      allow update: if isSignedIn() &&
                       usageDocId == 'global' &&
                       incoming().keys().hasAll(['usedBytes', 'quotaBytes', 'warningThresholdPercent', 'fileCount', 'photoBytes', 'videoBytes', 'audioBytes', 'activeBackendLabel', 'updatedAt']) &&
                       incoming().keys().hasOnly(['usedBytes', 'quotaBytes', 'warningThresholdPercent', 'fileCount', 'photoBytes', 'videoBytes', 'audioBytes', 'activeBackendLabel', 'updatedAt']) &&
                       isValidStorageUsage(incoming()) &&
                       (
                         isModerator() ||
                         (
                           incoming().warningThresholdPercent == existing().warningThresholdPercent &&
                           incoming().quotaBytes == existing().quotaBytes &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['usedBytes', 'fileCount', 'photoBytes', 'videoBytes', 'audioBytes', 'activeBackendLabel', 'updatedAt'])
                         )
                       );

      allow delete: if false;
    }
  }
}
